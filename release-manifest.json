{
  "schemaVersion": "xtapp-codex-plugin-distribution/v1",
  "repositoryName": "xtapp-codex-plugin",
  "primaryAudience": "agent",
  "agentEntrypoint": "AGENTS.md",
  "distributionRepository": "https://github.com/linchuanXu/xtapp-codex-plugin",
  "distributionStatus": "published-git-marketplace",
  "supportedHosts": ["codex", "cursor"],
  "cursor": {
    "previewSurface": "builtin-browser",
    "mcp": "bundled xtapp_studio stdio",
    "install": "docs/INSTALL_CURSOR.md",
    "userConfigWriter": "scripts/cursor-mcp-config.mjs"
  },
  "marketplace": {
    "name": "xtapp-codex-plugin-github",
    "gitSource": "linchuanXu/xtapp-codex-plugin",
    "gitRef": "main",
    "manifest": ".agents/plugins/marketplace.json"
  },
  "plugin": {
    "name": "xtapp-codex-plugin",
    "version": "0.1.5",
    "path": ".",
    "displayName": "XTApp Studio",
    "selector": "xtapp-codex-plugin@xtapp-codex-plugin-github",
    "mcpName": "xtapp_studio"
  },
  "source": {
    "runtime": "signed-in-xtapp-studio",
    "defaultPreviewHost": "https://xtapp-ai-dev.xteink.cn",
    "previewUrlSource": "get_xtapp_preview_status"
  }
}
